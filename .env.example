COMPOSE_PROJECT_NAME=atobot
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
REDIS_PASSWORD=CHANGE_ME_use_a_long_random_password

# Safe default: expose the UI only on this computer. Set to 0.0.0.0 only when
# LAN access is intentionally required and the host firewall is configured.
FRONTEND_BIND_ADDRESS=127.0.0.1
VITE_ENABLE_EXPERIMENTAL_CATO=false
